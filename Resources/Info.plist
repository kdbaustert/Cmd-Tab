<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>CmdTab</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.cmdtab.CmdTab</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Cmd-Tab</string>
	<key>CFBundleDisplayName</key>
	<string>Cmd-Tab</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Cmd-Tab. All rights reserved.</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- `cmdtab://` — every global action reachable without spending a hotkey, so Raycast, Alfred,
	     Shortcuts, Keyboard Maestro and a shell script can drive the window manager. The verbs and
	     what is deliberately left out of them are in `URLCommands.swift`. `LSUIElement` above does
	     not conflict with this: an agent can register a scheme and is launched to handle it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cmdtab.CmdTab.command</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cmdtab</string>
			</array>
		</dict>
	</array>
	<!-- Sparkle. The appcast is served from GitHub Pages rather than raw.githubusercontent.com:
	     the raw host is not a CDN, rate-limits, and sends a content type that some proxies mangle,
	     and this URL is baked into every shipped bundle so it is not one to get wrong twice. -->
	<key>SUFeedURL</key>
	<string>https://kdbaustert.github.io/Cmd-Tab/appcast.xml</string>
	<!-- The public half of the EdDSA key pair. Sparkle verifies every downloaded archive against
	     this before unpacking it, which is what makes an HTTPS feed safe to trust: even a
	     compromised host cannot ship this app's users a binary signed by anyone else. The private
	     half lives in the maintainer's login keychain and in the SPARKLE_PRIVATE_KEY secret. -->
	<key>SUPublicEDKey</key>
	<string>FYMMALSs2mAccV/rUgQcByyY+mdkpXSBA/nD4JpwvT0=</string>
	<!-- Checks run, but nothing installs itself without being asked. This app owns ⌘-Tab for the
	     whole machine; replacing itself mid-session is worth a prompt. Both are user-overridable
	     in Settings → About → Updates. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<!-- A day. Sparkle's own default, stated rather than inherited so changing it is a diff. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
