            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Ask first for Quit and Force-quit. One key separates ⌥W (close a window) from ⌥Q (quit the app), and only one of them can be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask first for Quit and Force-quit. One key separates ⌥W (close a window) from ⌥Q (quit the app), and only one of them can be undone."
          }
        }
      }
    },
    "Backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
