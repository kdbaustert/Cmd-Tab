    "Application mode only — a window list has as many tiles per app as the app has windows, so no app can hold a slot in it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application mode only — a window list has as many tiles per app as the app has windows, so no app can hold a slot in it."
          }
        }
      }
    },
