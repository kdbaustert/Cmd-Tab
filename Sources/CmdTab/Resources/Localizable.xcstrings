          }
        }
      }
    },
    "Window lists only — application tiles are one per app already.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window lists only — application tiles are one per app already."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listes de fenêtres uniquement — les vignettes d'application sont déjà uniques par application."
          }
        }
      }
    },
    "Window tiling": {
      "extractionState": "manual",
