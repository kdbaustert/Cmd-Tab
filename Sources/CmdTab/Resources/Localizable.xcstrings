    "Unbound by default: these act system-wide and have no natural home key, so the combination is yours to pick rather than ours to claim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbound by default: these act system-wide and have no natural home key, so the combination is yours to pick rather than ours to claim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non associés par défaut : ils agissent sur tout le système et n'ont pas de touche naturelle, la combinaison vous revient donc plutôt que de nous revenir."
          }
