    "For the handful of apps you reach for all day, the switcher is overhead. These jump straight there, launching the app if it isn't running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the handful of apps you reach for all day, the switcher is overhead. These jump straight there, launching the app if it isn't running."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la poignée d'applications que vous utilisez toute la journée, le sélecteur est un détour. Ces raccourcis y mènent directement, en lançant l'application si elle ne tourne pas."
          }
        }
      }
    },
