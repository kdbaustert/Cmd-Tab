      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behavior"
          }
        }
      }
    },
    "Bindings are matched in the order listed above, so the first one to claim a combination is the one that fires. Openers come first: nothing you bind can take the switcher's own trigger away from it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bindings are matched in the order listed above, so the first one to claim a combination is the one that fires. Openers come first: nothing you bind can take the switcher's own trigger away from it."
          }
        }
      }
    },
