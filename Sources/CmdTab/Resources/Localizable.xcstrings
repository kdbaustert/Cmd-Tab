{
  "sourceLanguage": "en",
  "strings": {
    "A second shortcut that shows only the frontmost app's windows. Off by default — the usual ⌘` is a shortcut apps use themselves.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A second shortcut that shows only the frontmost app's windows. Off by default — the usual ⌘` is a shortcut apps use themselves."
          }
        }
      }
    },
    "A theme carries only the look — never a shortcut — so importing one can not change what your keys do.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A theme carries only the look — never a shortcut — so importing one can not change what your keys do."
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
