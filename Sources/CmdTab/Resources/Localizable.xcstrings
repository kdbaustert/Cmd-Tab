    },
    "Bring back exactly what Hide all hid — apps you hid yourself stay hidden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring back exactly what Hide all hid — apps you hid yourself stay hidden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit exactement ce que « Masquer toutes les fenêtres » avait masqué — les applications que vous avez masquées vous-même le restent."
          }
        }
      }
    },
    "Build": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de compilation"
          }
        }
      }
    },
    "Captures come back empty, so tiles fall back to icons and hover previews show nothing. Turn Cmd-Tab off and on again in the Screen Recording list, then relaunch — the grant is tied to the app's signature, so a rebuilt or updated copy loses it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures come back empty, so tiles fall back to icons and hover previews show nothing. Turn Cmd-Tab off and on again in the Screen Recording list, then relaunch — the grant is tied to the app's signature, so a rebuilt or updated copy loses it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures reviennent vides : les vignettes retombent sur les icônes et les aperçus au survol n'affichent rien. Désactivez puis réactivez Cmd-Tab dans la liste Enregistrement de l'écran, puis relancez l'application — l'autorisation est liée à sa signature, donc une copie recompilée ou mise à jour la perd."
          }
        }
      }
    },
    "Center": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center"
