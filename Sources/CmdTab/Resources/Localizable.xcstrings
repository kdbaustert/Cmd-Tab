    },
    "Accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        }
      }
    },
    "Accessibility is granted per binary. A rebuild signed with a different certificate looks like a new app to macOS and has to be granted again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is granted per binary. A rebuild signed with a different certificate looks like a new app to macOS and has to be granted again."
          }
        }
      }
    },
    "Act on the highlighted tile without leaving the switcher. Each is a key plus ⌥ or ⌃ held on top of the trigger — an extra modifier is required, since a bare letter is type-to-filter input.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act on the highlighted tile without leaving the switcher. Each is a key plus ⌥ or ⌃ held on top of the trigger — an extra modifier is required, since a bare letter is type-to-filter input."
          }
        }
      }
    },
